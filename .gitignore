# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
# Added by code-review-graph
.code-review-graph/

# Playwright
/test-results/
/playwright-report/

# graphify — regenerated by `graphify update .`, which is AST-only and free.
# The dated backup dirs, graph.json/html, GRAPH_REPORT.md and cache/ all churn
# on every run and were dirtying every commit.
#
# .graphify_labels.json is the one exception and stays tracked: the semantic
# labels behind it came from a paid API pass (see the cost.json files), so it is
# not something `graphify update` can rebuild for nothing.
graphify-out/*
!graphify-out/.graphify_labels.json
!.env.example

# Compiled seed generator (pnpm gen:seed) — build artefact.
.seed-build/
