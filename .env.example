# Copy to .env.local. For local development the values come from `supabase status`
# after `pnpm supabase:start`; the local anon/service keys are the same fixed
# demo keys on every machine, so they are safe to share. Cloud values are not.

# Public — shipped to the browser. Safe: everything this key can do is decided
# by RLS against the signed-in user's JWT.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only, NEVER prefixed NEXT_PUBLIC_ and never used in a request path.
# It bypasses RLS entirely (plans/BACKEND.md §1). Seeds and migrations only.
SUPABASE_SERVICE_ROLE_KEY=

# --- B8: email (decision 14) ---
# SMTP for the four approved mail classes. Leave blank and nothing is sent: the
# queue records "SMTP is not configured" as the row's last_error rather than
# draining silently into nothing.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- B8: scheduled jobs ---
# The cron routes (/api/cron/email, /api/cron/expiring) run as a dedicated QAC
# Admin *account*, not the service role — see src/lib/supabase/mailer.ts. Seeded
# locally as mailer@pup.edu.ph / DevPassword1 by supabase/seed-dev.sql.
MAILER_EMAIL=
MAILER_PASSWORD=

# Shared secret for those two routes. A missing value DENIES: an unset secret
# must not leave a scheduled endpoint open to anyone who knows the URL.
CRON_SECRET=
