{"nodes": [{"id": "plans_03a_portal_ui_static_phase", "label": "Phase 3a - Portal UI (static, no backend)", "file_type": "document", "source_file": "plans/03a-portal-ui-static.md", "source_location": "plans/03a-portal-ui-static.md:1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Build every screen of all four internal roles as static UI matching the owner's Figma. When the backend lands, the screens should not change - only their data source."}, {"id": "plans_03a_portal_ui_static_figma_source_of_truth", "label": "assets/FIGMA/ Is the Only Source of Truth", "file_type": "concept", "source_file": "plans/03a-portal-ui-static.md", "source_location": "plans/03a-portal-ui-static.md:22", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One folder per role plus _shared/, login/ and register/, numbered in build order. If a folder is empty the owner has not exported it yet - ask, do not invent the screens."}, {"id": "plans_03a_portal_ui_static_vocabulary_mismatch", "label": "The Vocabulary-Mismatch Blocker", "file_type": "rationale", "source_file": "plans/03a-portal-ui-static.md", "source_location": "plans/03a-portal-ui-static.md:15", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Phase 3 sat blocked for two sessions on a per-role page inventory that was never missing: the owner had the full Figma the whole time. The vocabulary ('inventory', 'shell', 'component kit') stopped them recognising what was being asked for. Ask in plain words, and confirm a block is real before declaring it."}, {"id": "plans_03a_portal_ui_static_derived_tokens_sanction", "label": "Sanction for Deriving Missing Portal Colors", "file_type": "rationale", "source_file": "plans/03a-portal-ui-static.md", "source_location": "plans/03a-portal-ui-static.md:66", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Five colors and four type sizes cannot dress a portal - no status-badge colors, no border, hover or disabled, and a large gap between 15px body and 36px title. Derive from maroon/yellow/gray and record every addition in figma-tokens.md under 'derived, pending client sign-off'. That section is the only sanctioned place."}, {"id": "plans_03a_portal_ui_static_dev_role_switcher", "label": "Dev-Only Role Switcher", "file_type": "rationale", "source_file": "plans/03a-portal-ui-static.md", "source_location": "plans/03a-portal-ui-static.md:50", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "So all four roles are clickable without real accounts. Must be trivially removable - it is a preview affordance, never an auth mechanism."}, {"id": "plans_03a_portal_ui_static_role_slug_decision", "label": "Role Slug Is program_representative", "file_type": "rationale", "source_file": "plans/03a-portal-ui-static.md", "source_location": "plans/03a-portal-ui-static.md:64", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Owner chose it over academic_representative on 2026-07-23."}, {"id": "plans_03a_portal_ui_static_out_of_scope", "label": "Backend Explicitly Out of Scope for 3a", "file_type": "rationale", "source_file": "plans/03a-portal-ui-static.md", "source_location": "plans/03a-portal-ui-static.md:98", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No Supabase client, middleware, RLS, API routes, sessions, email or PDF processing. Nothing @supabase/* is installed and no .env* exists - keep it that way. The (public) migration is also not part of this phase."}, {"id": "plans_03a_portal_ui_static_fake_data_typed_in", "label": "Fake Data Typed Into the Files", "file_type": "concept", "source_file": "plans/03a-portal-ui-static.md", "source_location": "plans/03a-portal-ui-static.md:53", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Kept in a clearly-named array per screen so the swap point is obvious when the backend arrives."}], "edges": [{"source": "plans_03a_portal_ui_static_phase", "target": "plans_03a_portal_ui_static_figma_source_of_truth", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "plans/03a-portal-ui-static.md", "source_location": "plans/03a-portal-ui-static.md:1", "weight": 1.0}, {"source": "plans_03a_portal_ui_static_phase", "target": "plans_03a_portal_ui_static_vocabulary_mismatch", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "plans/03a-portal-ui-static.md", "source_location": "plans/03a-portal-ui-static.md:1", "weight": 1.0}, {"source": "plans_03a_portal_ui_static_phase", "target": "plans_03a_portal_ui_static_derived_tokens_sanction", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "plans/03a-portal-ui-static.md", "source_location": "plans/03a-portal-ui-static.md:1", "weight": 1.0}, {"source": "plans_03a_portal_ui_static_phase", "target": "plans_03a_portal_ui_static_dev_role_switcher", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "plans/03a-portal-ui-static.md", "source_location": "plans/03a-portal-ui-static.md:1", "weight": 1.0}, {"source": "plans_03a_portal_ui_static_phase", "target": "plans_03a_portal_ui_static_role_slug_decision", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "plans/03a-portal-ui-static.md", "source_location": "plans/03a-portal-ui-static.md:1", "weight": 1.0}, {"source": "plans_03a_portal_ui_static_phase", "target": "plans_03a_portal_ui_static_out_of_scope", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "plans/03a-portal-ui-static.md", "source_location": "plans/03a-portal-ui-static.md:1", "weight": 1.0}, {"source": "plans_03a_portal_ui_static_phase", "target": "plans_03a_portal_ui_static_fake_data_typed_in", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "plans/03a-portal-ui-static.md", "source_location": "plans/03a-portal-ui-static.md:1", "weight": 1.0}, {"source": "plans_03a_portal_ui_static_phase", "target": "plans_03a_ui_build_runbook_procedure", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "plans/03a-portal-ui-static.md", "source_location": "plans/03a-portal-ui-static.md:94", "weight": 1.0}, {"source": "plans_03a_portal_ui_static_phase", "target": "design_prototype_notes_method", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "plans/03a-portal-ui-static.md", "source_location": "plans/03a-portal-ui-static.md:77", "weight": 1.0}, {"source": "plans_03a_portal_ui_static_phase", "target": "claude_never_run_git", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "plans/03a-portal-ui-static.md", "source_location": "plans/03a-portal-ui-static.md:75", "weight": 1.0}, {"source": "plans_03a_portal_ui_static_derived_tokens_sanction", "target": "claude_design_system_rule", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "plans/03a-portal-ui-static.md", "source_location": "plans/03a-portal-ui-static.md:71", "weight": 1.0}, {"source": "plans_03a_portal_ui_static_derived_tokens_sanction", "target": "design_figma_tokens_derived_tokens", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "plans/03a-portal-ui-static.md", "source_location": "plans/03a-portal-ui-static.md:69", "weight": 1.0}, {"source": "plans_03a_portal_ui_static_role_slug_decision", "target": "prd_role_program_representative", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "plans/03a-portal-ui-static.md", "source_location": "plans/03a-portal-ui-static.md:64", "weight": 1.0}, {"source": "pla