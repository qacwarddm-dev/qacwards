e": "plans/03a-ui-build-runbook.md", "source_location": "plans/03a-ui-build-runbook.md:1", "weight": 1.0}, {"source": "plans_03a_ui_build_runbook_procedure", "target": "plans_03a_ui_build_runbook_portal_bold_rule", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "plans/03a-ui-build-runbook.md", "source_location": "plans/03a-ui-build-runbook.md:1", "weight": 1.0}, {"source": "plans_03a_ui_build_runbook_procedure", "target": "plans_03a_portal_ui_static_phase", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "plans/03a-ui-build-runbook.md", "source_location": "plans/03a-ui-build-runbook.md:3", "weight": 1.0}, {"source": "plans_03a_ui_build_runbook_procedure", "target": "design_prototype_notes_method", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "plans/03a-ui-build-runbook.md", "source_location": "plans/03a-ui-build-runbook.md:15", "weight": 1.0}, {"source": "plans_03a_ui_build_runbook_procedure", "target": "design_figma_tokens_source_of_truth", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "plans/03a-ui-build-runbook.md", "source_location": "plans/03a-ui-build-runbook.md:14", "weight": 1.0}, {"source": "plans_03a_ui_build_runbook_procedure", "target": "claude_never_run_git", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "plans/03a-ui-build-runbook.md", "source_location": "plans/03a-ui-build-runbook.md:13", "weight": 1.0}, {"source": "plans_03a_ui_build_runbook_identity_seam", "target": "plans_03a_ui_build_runbook_sidebar_must_receive_user", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "plans/03a-ui-build-runbook.md", "source_location": "plans/03a-ui-build-runbook.md:115", "weight": 1.0}, {"source": "plans_03a_ui_build_runbook_identity_seam", "target": "plans_03a_ui_build_runbook_empty_sidebar_by_design", "re