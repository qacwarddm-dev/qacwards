m_viewport_units_trap", "target": "src_app_portal_layout_portallayout", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/prototype-notes.md", "source_location": "design/prototype-notes.md:52", "weight": 1.0}, {"source": "design_prototype_notes_navbar_dropdown_spec", "target": "src_components_navbar_navbar", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/prototype-notes.md", "source_location": "design/prototype-notes.md:162", "weight": 1.0}, {"source": "design_prototype_notes_navbar_hover_feedback", "target": "src_components_navbar_navlink", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/prototype-notes.md", "source_location": "design/prototype-notes.md:163", "weight": 1.0}, {"source": "design_prototype_notes_navbar_height_mismatch", "target": "src_components_navbar", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/prototype-notes.md", "source_location": "design/prototype-notes.md:191", "weight": 1.0}, {"source": "design_prototype_notes_about_page_facts", "target": "src_app_about_page", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/prototype-notes.md", "source_location": "design/prototype-notes.md:90", "weight": 1.0}, {"source": "design_prototype_notes_campuses_page_facts", "target": "src_app_about_campuses_page", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/prototype-notes.md", "source_location": "design/prototype-notes.md:123", "weight": 1.0}, {"source": "design_prototype_notes_accreditations_page_facts", "target": "src_app_accreditations_page", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/prototype-notes.md", "source_location": "design/prototype-notes.md:109", "weight": 1.0}, {"source": "design_prototype_notes_gov_recognitions_page_facts", "target": "src_app_gov_recognitions_page", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/prototype-notes.md", "source_location": "design/prototype-notes.md:115", "weight": 1.0}], "hyperedges": []}